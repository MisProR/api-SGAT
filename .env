# ===================== SGAT API =====================
# Copie este archivo como .env y ajuste los valores.

APP_ENV=development
APP_PORT=8080

# Conexión a SQL Server (usuario creado en database/db/01_crear_base_datos.sql)
#   Instancia por defecto : sqlserver://usuario:clave@localhost:1433?database=sgat&encrypt=disable
#   Instancia con nombre  : sqlserver://usuario:clave@localhost/SQLEXPRESS?database=sgat&encrypt=disable
#   Con TLS (certificado autofirmado): ...&encrypt=true&TrustServerCertificate=true
# Use el login sgat_app: su esquema por defecto es "SGAT" (con "sa" el esquema por defecto es dbo).
DATABASE_URL=sqlserver://sgat_app:SgatApp2026*@localhost:1433?database=sgat&encrypt=disable&app+name=sgat-api
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Clave para firmar los JWT: mínimo 32 caracteres aleatorios.
# Genere una con:  openssl rand -base64 48
JWT_SECRET=KytgQXkOA5bJ3J4DulMTJkXkzAkZmeL5ExF5m0UjIkUgNxBzEpBr5qbVu8Ei4kO8
JWT_ISSUER=sgat-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# En producción (HTTPS) COOKIE_SECURE debe ser true
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Orígenes permitidos del frontend (separados por coma)
CORS_ORIGINS=http://localhost:4200

# Seguridad de inicio de sesión
LOGIN_RATE_LIMIT=10
MAX_LOGIN_FAILS=5
LOCKOUT_DURATION=15m


